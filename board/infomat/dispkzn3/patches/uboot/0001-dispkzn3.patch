diff --git a/configs/infomat_dispkzn3_defconfig b/configs/infomat_dispkzn3_defconfig
new file mode 100644
index 000000000..566d04cb1
--- /dev/null
+++ b/configs/infomat_dispkzn3_defconfig
@@ -0,0 +1,26 @@
+CONFIG_ARM=y
+CONFIG_ARCH_SUNXI=y
+CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun8i-t113s-infomat-dispkzn3"
+CONFIG_DRAM_CLK=792
+CONFIG_SPL=y
+CONFIG_DRAM_SUNXI_ODT_EN=0
+CONFIG_DRAM_SUNXI_TPR0=0x004a2195
+CONFIG_DRAM_SUNXI_TPR11=0x340000
+CONFIG_DRAM_SUNXI_TPR12=0x46
+CONFIG_DRAM_SUNXI_TPR13=0x34000100
+CONFIG_MACH_SUN8I_R528=y
+CONFIG_DRAM_ZQ=8092667
+CONFIG_SUNXI_MINIMUM_DRAM_MB=128
+# CONFIG_SYS_MALLOC_CLEAR_ON_INIT is not set
+CONFIG_CONS_INDEX=2
+CONFIG_UART1_PORT_E=y
+CONFIG_MMC_BROKEN_CD=y
+CONFIG_CMD_DIAG=y
+CONFIG_MISC=y
+CONFIG_RMII=y
+CONFIG_SUN8I_EMAC=y
+CONFIG_TOOLS_MKEFICAPSULE=n
+CONFIG_EFI_LOADER=n
+CONFIG_DM_I2C=y
+CONFIG_SYS_I2C_MVTWSI=y
+CONFIG_CMD_I2C=y
