+      - enum: 
+          - allwinner,sun20i-d1-iommu
+          - allwinner,sun50i-h6-iommu
       - const: allwinner,sun50i-h616-iommu
       - items:
           - const: allwinner,sun55i-a523-iommu
@@ -42,8 +44,22 @@ required:
   - reg
   - interrupts
