 	sun50i_domain = to_sun50i_domain(iommu->domain);
 
 	ret = reset_control_deassert(iommu->reset);
-	if (ret)
+	if (ret) {
+		dev_err(iommu->dev, "failed to deassert reset: %d\n", ret);
 		return ret;
