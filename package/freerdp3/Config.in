config BR2_PACKAGE_FREERDP3
    bool "freerdp3"
    depends on BR2_INSTALL_LIBSTDCPP      # Требуется компилятор C++[reference:1]
    depends on BR2_USE_WCHAR              # Требуется поддержка широких символов[reference:2]
    depends on BR2_TOOLCHAIN_HAS_THREADS  # Требуется поддержка потоков[reference:3]
    depends on BR2_USE_MMU                # Требуется MMU (зависимость libglib2)[reference:4]
    depends on BR2_TOOLCHAIN_HAS_SYNC_4   # Требуется атомарные операции[reference:5]
    select BR2_PACKAGE_OPENSSL            # Криптографическая библиотека[reference:6]
    select BR2_PACKAGE_ZLIB               # Сжатие данных[reference:7]
    select BR2_PACKAGE_LIBGLIB2           # Базовая библиотека Glib[reference:8]
    select BR2_PACKAGE_SDL2               # Графическая библиотека SDL2
    select BR2_PACKAGE_SDL2_KMSDRM        # Драйвер KMS/DRM для SDL2
    select BR2_PACKAGE_LIBDRM             # Библиотека DRM (потребуется для KMS)[reference:9]
    help
      FreeRDP is a free implementation of the Remote Desktop Protocol (RDP).
      This package builds the SDL2 client with KMS/DRM video driver support.

      http://www.freerdp.com/
